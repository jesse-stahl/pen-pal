rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMember(listId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/lists/$(listId)).data.memberUids;
    }

    match /users/{uid} {
      allow read: if signedIn();                 // members need to read partner display info
      allow write: if signedIn() && request.auth.uid == uid;

      match /study/{groupId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    match /lists/{listId} {
      // Read/query authorized from the doc's own fields (required for the array-contains
      // query in userListsQuery — get()-based rules can't authorize a collection query).
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid
                    && request.auth.uid in request.resource.data.memberUids;
      // Existing members may update (rename, counters); a signed-in user may also add
      // themselves to memberUids — this is how accepting an invite (join) works.
      allow update: if signedIn() && (
        request.auth.uid in resource.data.memberUids
        || request.auth.uid in request.resource.data.memberUids
      );
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /words/{wordId} {
        allow read, write: if isMember(listId);
      }
    }

    // Static invite codes: invites/{code} maps a code → list. Anyone signed in can
    // read (to join); the code's creator (list owner) creates and rotates/deletes it.
    match /invites/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
      allow update: if false;
    }

    // usernames/{username}: reverse lookup for uniqueness + friend search.
    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // friendRequests/{sortedPairId}: sender creates (pending); recipient accepts
    // (pending→accepted); either party can read or delete (deny / unfriend).
    match /friendRequests/{id} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
      allow create: if signedIn()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if signedIn()
        && request.auth.uid == resource.data.to
        && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if signedIn()
        && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
    }

    match /trades/{pairKey} {
      allow read: if signedIn() && request.auth.uid in resource.data.uids;
      allow write: if false;                      // only Cloud Functions (admin) write trades
    }
  }
}
